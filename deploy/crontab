# crontab -e （アプリを動かしているユーザで）
# TZ はサーバを Asia/Tokyo にするか、CRON_TZ を付ける。
# ログは deploy/cron-run.sh が /var/log/app/<stem>.log に書く。ここではリダイレクトしない。

CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# VPS パッケージ一覧 → data/inventory（読み取り専用。セキュリティ照合用。07:00 より前）
40 6 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/ops/vps_packages_r2.py

# 日次（引け後の開示を夜に取る）
30 19 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/run_batch.py

# 株探 PTS ナイトタイム ランキング → pts_snapshots（平日 15:30〜24:00 の 30 分ごと。株探は 15 分ディレイ）
# 同じセッション・同じ「HH:MM現在」は書かない。翌日 15:30 の回が前夜の最終（06:00）を拾う
30 15 * * 1-5 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/pts_snapshot.py
0,30 16-23 * * 1-5 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/pts_snapshot.py
0 0 * * 2-6 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/pts_snapshot.py

# yfinance 1 分足（直近 7 日）→ data/intraday/1m（KAB-208）。日次バッチ（19:30。19:45 ごろ終わる）の後
30 20 * * 1-5 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/intraday_1m.py

# Frankfurter / ECB 対EUR 日次レート。公表は 16:00 CET 前後なので翌朝 JST。空なら 1999-01-04〜。
0 8 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/fx_rates.py

# TDnet 月次PDF → data/monthly（一覧は TDnet。直近7日分。取りこぼしの拾い直し。既存は skip）
0 18 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_r2.py 7
0 21 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_r2.py 7

# TDnet 決算説明資料 PDF → data/briefing（一覧は TDnet。直近7日。既存 PDF は skip。初回の30日は手で一度）
10 22 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/tdnet_briefing_r2.py 7

# 会社の IR ページ・eir-parts の決算説明資料を全社見る回（KAB-438。週 1 回。短信から日がたって載る質疑応答などの拾い直し。
# 資料ありの短信なのに索引に無く設定にも無い会社を missing に出す）。毎日の分は下の XBRL の毎時の行
25 22 * * 0 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/homepage_briefing.py --years 5 --ledger /var/log/app/homepage_briefing_ledger.json
# 決算短信の表紙の「補足説明資料の有無」「説明会の有無」→ tanshin_covers（KAB-416）。直近 3 日に短信を出した会社の最新 1 件
# 23:35 は XBRL の最後の回（23:00）のあと。初回は --days を 1 四半期より長くして手で一度
35 23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/tanshin_covers.py --days 3
# TDnet 月次PDF → ingest JSON（前回投入分と同じ書式だけ。自動 POST しない）→ DB（loopback POST。ledger は dest に置かない）
20 18 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_pdf_sidecar.py
20 21 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_pdf_sidecar.py
30 18 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_pdf_ingest.py --ledger /var/log/app/pdf_ingest_ledger.json
30 21 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/tdnet_monthly_pdf_ingest.py --ledger /var/log/app/pdf_ingest_ledger.json

# IR 月次 PDF/xlsx → data/monthly（TDnet に月次が無い発行体。config/monthly/ir_monthly.json issuers）
0 10 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_r2.py
0 16 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_r2.py

# IR 月次 HTML → data/monthly + ingest JSON（自動 POST しない。config/monthly/ir_monthly.json html）
20 10 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_html_r2.py
20 16 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_html_r2.py

# IR 月次 HTML → DB（loopback POST。取得の後。ledger は dest に置かない）
30 10 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_html_ingest.py --ledger /var/log/app/html_ingest_ledger.json
30 16 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_html_ingest.py --ledger /var/log/app/html_ingest_ledger.json

# IR 月次 JSON → DB（loopback POST。CloudFront GET。7649 スギHD。year は送らない）
30 10 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_json_ingest.py
30 16 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_json_ingest.py

# IR 月次 xls/xlsx → DB（loopback POST。ir_monthly_r2 の取得の後。config/monthly/ir_monthly_xls.json の全銘柄の最新ファイル）
40 10 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_xls_ingest.py --all --post
40 16 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/monthly/ir_monthly_xls_ingest.py --all --post

# TDnet XBRL ZIP → parse → normalize → statements（一覧は TDnet。前日と当日・毎時 12–23。
# 取得のあと続けて走らせる。取得が失敗しても parse / normalize は走らせる（手元の未解析 ZIP を拾う）。
# :10 / :20 の単独 cron は置かない。取りこぼしは次の毎時。手でやり直すときは各ジョブを cron-run.sh で単独実行）
# 続けて短信の表紙（その日の分）→ TDnet の説明資料（その日の分）→ 会社ページの説明資料（KAB-438。直近 7 日に
# 資料ありの短信を出し、まだ資料を取れていない設定の会社だけ。短信の直後に 1 回、以後 1 日 1 回）
0 12-23 * * * cd /home/stock/stock-analyzer && { deploy/cron-run.sh jobs/xbrl/tdnet_xbrl_r2.py 2; deploy/cron-run.sh jobs/xbrl/xbrl_parse.py; deploy/cron-run.sh jobs/xbrl/xbrl_normalize.py; deploy/cron-run.sh jobs/xbrl/xbrl_statements.py; deploy/cron-run.sh jobs/market/tanshin_covers.py --days 1; deploy/cron-run.sh jobs/market/tdnet_briefing_r2.py 1; deploy/cron-run.sh jobs/market/homepage_briefing.py --years 5 --pending 7 --ledger /var/log/app/homepage_briefing_ledger.json; }

# EDINET（KAB-72）。コードリスト → edinet_filers / stocks.edinet_code（キー不要）、書類一覧 → edinet_documents（EDINET_API_KEY）
# 一覧は直近 7 日の未確定の日だけ取る。前日分は翌朝の回で確定する
# 取込済みで ZIP を残していない書類を取り直す（KAB-281。docs/jobs/edinet.md「ZIP の退避と過去分の取り直し」）。ほかの EDINET ジョブの前の夜間
15 0-6 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_archive.py --limit 1000
30 7 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_codes.py
40 8-23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_documents.py
# 有報・半期報の XBRL → xbrl_financials（KAB-73）。新しい書類から 1 回 300 件（約 14 分）。過去分は毎時少しずつ
50 8-23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_xbrl.py --limit 300
# 大量保有報告書 → large_holding_reports / large_holdings（KAB-74）。新しい書類から 1 回 1000 件（約 17 分）。:40 / :50 に重ねない
5 9-23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_large_holdings.py --limit 1000
# 公開買付の書類 → edinet_tender_offer_docs / edinet_tender_offers（KAB-79）。1 回 100 件（5 分以内）。:25 に重ねない
20 9-23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_tender_offers.py --limit 100
# 自己株券買付状況報告書 → edinet_buybacks / edinet_buyback_resolutions（KAB-79）。1 回 500 件（約 9 分）。:40 に重ねない
25 9-23 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/edinet/edinet_buybacks.py --limit 500

# 素材の月次量 → material_monthly（サプライタブ）
# 経産省 Excel（生産動態と石油統計。速報は翌月末、確報は翌々月中旬）。毎日見て、変わっていなければ同じ値の UPSERT
# 生産動態と石油統計は時刻をずらす（METI の WAF は続けて取ると bot 確認を返す）。取り込み済みの年報は落とさない
15 7 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/supply/material_stats.py --source meti --only seidou --ledger /var/log/app/material_stats_ledger.json
45 7 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/supply/material_stats.py --source meti --only sekiyu --ledger /var/log/app/material_stats_ledger.json
# e-Stat（生産動態の年報、貿易統計）。ESTAT_APP_ID が無ければ何もしない
10 7 * * 1 cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/supply/material_stats.py --source estat

# 1 年以上前の決算説明資料 → OneDrive（KAB-345）。毎日 1 回（KAB-353）。
# 01:40 は 00:00 の PTS、0–6 時 :15 の edinet_archive、03:30 の backup_data、05:00 の backup_db と開始がずれている。
# 二重起動はジョブが止める。手の全件移動が先に動いていても、こちらは始めない。
40 1 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/market/briefing_offsite.py

# data/xbrl と data/monthly を OneDrive へ copy、data/edinet は move（sync はしない。手順は docs/DESIGN_backup.md）
# 03:30 は data/xbrl と data/monthly に書くジョブ（10〜23 時）と backup_db（05:00）の間。data/edinet は edinet_archive（0〜6 時）と重なる（10 分より古い ZIP だけ送る）。
# edinet の move は 50 分で区切る（残りは翌日。打ち切りは fail にしない）。
30 3 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/ops/backup_data.py

# SQLite 整合バックアップ。OneDrive へ送れて確認できたら、今回の gzip は VPS から消す。
# 05:00 は run_batch（19:30）と XBRL（12–23 時）と重ならない。手順は docs/DESIGN_backup.md
0 5 * * * cd /home/stock/stock-analyzer && deploy/cron-run.sh jobs/ops/backup_db.py
