# crontab -e （アプリを動かしているユーザで）
# TZ はサーバを Asia/Tokyo にするか、CRON_TZ を付ける。

CRON_TZ=Asia/Tokyo
SHELL=/bin/bash

# 日次（引け後の開示を夜に取る）
30 19 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/run_batch.py >> /var/log/app/batch.log 2>&1

# 取りこぼし（翌朝）
0 6 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/run_batch.py >> /var/log/app/batch.log 2>&1

# TDnet 月次PDF → R2 mount（当日分）
0 18 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/tdnet_monthly_r2.py 1 >> /var/log/app/batch.log 2>&1
0 21 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/tdnet_monthly_r2.py 1 >> /var/log/app/batch.log 2>&1

# IR 月次 PDF/xlsx → R2 mount（TDnet に月次が無い発行体。config/ir_monthly.json）
0 10 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/ir_monthly_r2.py >> /var/log/app/batch.log 2>&1
0 16 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/ir_monthly_r2.py >> /var/log/app/batch.log 2>&1

# TDnet XBRL ZIP → R2 mount（当日分・毎時 12–23）
0 12-23 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/tdnet_xbrl_r2.py 1 >> /var/log/app/batch.log 2>&1
10 12-23 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/xbrl_parse.py >> /var/log/app/batch.log 2>&1
20 12-23 * * * cd /home/stock/stock-analyzer && .venv/bin/python -u scripts/xbrl_normalize.py >> /var/log/app/batch.log 2>&1

