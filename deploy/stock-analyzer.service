[Unit]
Description=stock-analyzer (FastAPI)
After=network.target

[Service]
Type=simple
User=stock
Group=stock
WorkingDirectory=/home/stock/stock-analyzer
EnvironmentFile=-/home/stock/stock-analyzer/.env
Environment=PYTHONUNBUFFERED=1
LogsDirectory=app
LogsDirectoryMode=0755
StandardOutput=append:/var/log/app/stock-analyzer.log
StandardError=append:/var/log/app/stock-analyzer.log
# ワーカー数は deploy/uvicorn_workers.py（nproc と MemAvailable。UVICORN_WORKERS で上書き）。
# --preload は使わない。行頭の JST 時刻は MCP app_logs の since / until が読む
ExecStart=/bin/bash /home/stock/stock-analyzer/deploy/uvicorn-start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
