{
  "name": "stock-analyzer",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start-web.sh",
  "terminals": [
    {
      "name": "web-log",
      "description": "8000 の serve ログ。本体は start が起動する。UI 検証も 8000",
      "command": "mkdir -p /tmp && touch /tmp/stock-web.log && tail -F /tmp/stock-web.log"
    }
  ],
  "ports": [
    { "name": "web", "port": 8000 }
  ]
}
