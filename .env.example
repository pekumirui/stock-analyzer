# J-Quants API V2 のAPIキー
# https://jpx-jquants.com/ja のダッシュボード → APIキー発行 で取得
JQUANTS_API_KEY=your_api_key_here

# プラン別レートリミット (Free=5 / Light=60 / Standard=120 / Premium=500)
JQUANTS_RATE_LIMIT=60

# 本番 (Neon/Supabase Postgres) の場合のみ
# DATABASE_URL=postgresql://user:pass@host/db

# VPS 上の読み取り専用ログ MCP（Grok カスタムコネクタ用）
# openssl rand -hex 32 で作る。GitHub Actions secret と同値にする。
# MCP_TOKEN=

# Cloudflare R2（VPS の rclone mount 用。値は GitHub secrets から upsert。実キーはコミットしない）
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# TDnet XBRL parse（任意。未設定なら VPS 既定パス）
# XBRL_DEST=/home/stock/r2-share/xbrl
# タクソノミ同梱ディレクトリ（既定はリポジトリの data/xbrl_taxonomy）。ネットワークには出ない。
# XBRL_CACHE_DIR=data/xbrl_taxonomy
# XBRL_TEXT_MAX_CHARS=1000
