# J-Quants API V2 のAPIキー
# https://jpx-jquants.com/ja のダッシュボード → APIキー発行 で取得
JQUANTS_API_KEY=your_api_key_here

# プラン別レートリミット (Free=5 / Light=60 / Standard=120 / Premium=500)
JQUANTS_RATE_LIMIT=60

# 本番 (Neon/Supabase Postgres) の場合のみ
# DATABASE_URL=postgresql://user:pass@host/db

# VPS 上の読み取り専用ログ MCP（Grok カスタムコネクタ用）
# openssl rand -hex 32 で作る。GitHub Actions secret と同値にする。
# MCP_TOKEN=
# fs_list / fs_read / fs_grep の root。未設定なら data=リポジトリ data/、logs=/var/log/app。
# MCP_DATA_DIR=
# MCP_LOG_DIR=/var/log/app
# MCP_FS_MAX_BYTES=1048576
# MCP_FS_TIMEOUT=8

# Cloudflare R2（残置の rclone FUSE `/home/stock/r2-share` 用。ジョブの既定 dest は SHARE_ROOT / data/。実キーはコミットしない）
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# SQLite バックアップの OneDrive 送信（jobs/ops/backup_db.py）。トークンは ~/.config/rclone/rclone.conf
# BACKUP_OFFSITE=1
# BACKUP_OFFSITE_REMOTE=onedrive
# BACKUP_OFFSITE_PATH=stock-analyzer-backups
# BACKUP_LOCAL_DAILY_KEEP=1
# BACKUP_LOCAL_WEEKLY_KEEP=1
# BACKUP_OFFSITE_DAILY_KEEP=7
# BACKUP_OFFSITE_WEEKLY_KEEP=4

# TDnet XBRL parse（任意。未設定ならリポジトリの data/xbrl）
# XBRL_DEST=
# 共有ファイルのルート。未設定ならリポジトリの data/（monthly、xbrl、inventory、stats）。
# FUSE マウントのルートは R2_SHARE_ROOT（既定 /home/stock/r2-share）。SHARE_ROOT とは別。
# SHARE_ROOT=
# タクソノミ同梱ディレクトリ（既定はリポジトリの data/xbrl_taxonomy）。ネットワークには出ない。
# XBRL_CACHE_DIR=data/xbrl_taxonomy
# XBRL_TEXT_MAX_CHARS=1000
# ZIP 解析のプロセス数（DB 書き込みは親 1 本）。1 で直列
# XBRL_PARSE_WORKERS=2
# uvicorn ワーカー数。未設定なら nproc と MemAvailable から決める（1 本あたり 384MiB）
# UVICORN_WORKERS=
